<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_permission" />

            <Button
                android:id="@+id/btnRequestPermission"
                style="@style/DemoButton"
                android:text="@string/action_request_permission" />

            <Button
                android:id="@+id/btnPermissionState"
                style="@style/DemoButton"
                android:text="@string/action_permission_state" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_identity" />

            <Button
                android:id="@+id/btnLogin"
                style="@style/DemoButton"
                android:text="@string/action_login" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/DemoButton"
                android:text="@string/action_logout" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_tags" />

            <Button
                android:id="@+id/btnAddTag"
                style="@style/DemoButton"
                android:text="@string/action_add_tag" />

            <Button
                android:id="@+id/btnGetTags"
                style="@style/DemoButton"
                android:text="@string/action_get_tags" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_subscription" />

            <Button
                android:id="@+id/btnOptIn"
                style="@style/DemoButton"
                android:text="@string/action_opt_in" />

            <Button
                android:id="@+id/btnOptOut"
                style="@style/DemoButton"
                android:text="@string/action_opt_out" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_notifications" />

            <Button
                android:id="@+id/btnSetBadge"
                style="@style/DemoButton"
                android:text="@string/action_set_badge" />

            <Button
                android:id="@+id/btnClearBadge"
                style="@style/DemoButton"
                android:text="@string/action_clear_badge" />

            <Button
                android:id="@+id/btnClearAll"
                style="@style/DemoButton"
                android:text="@string/action_clear_all" />

        </LinearLayout>
    </ScrollView>

    <TextView
        style="@style/SectionHeader"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/section_log" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#F2F2F2"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </ScrollView>

</LinearLayout>
