<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_permission" />

            <Button
                android:id="@+id/btnRequestPermission"
                style="@style/DemoButton"
                android:text="@string/action_request_permission" />

            <Button
                android:id="@+id/btnPermissionState"
                style="@style/DemoButton"
                android:text="@string/action_permission_state" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_identity" />

            <EditText
                android:id="@+id/etExternalId"
                style="@style/DemoInput"
                android:hint="@string/hint_external_id"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnLogin"
                style="@style/DemoButton"
                android:text="@string/action_login" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/DemoButton"
                android:text="@string/action_logout" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_language" />

            <EditText
                android:id="@+id/etLanguage"
                style="@style/DemoInput"
                android:hint="@string/hint_language"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnSetLanguage"
                style="@style/DemoButton"
                android:text="@string/action_set_language" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_tags" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTagKey"
                    style="@style/DemoInput.Half"
                    android:hint="@string/hint_tag_key"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/etTagValue"
                    style="@style/DemoInput.Half"
                    android:hint="@string/hint_tag_value"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddTag"
                style="@style/DemoButton"
                android:text="@string/action_add_tag" />

            <Button
                android:id="@+id/btnRemoveTag"
                style="@style/DemoButton"
                android:text="@string/action_remove_tag" />

            <Button
                android:id="@+id/btnGetTags"
                style="@style/DemoButton"
                android:text="@string/action_get_tags" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_email" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/DemoInput"
                android:hint="@string/hint_email"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btnAddEmail"
                style="@style/DemoButton"
                android:text="@string/action_add_email" />

            <Button
                android:id="@+id/btnRemoveEmail"
                style="@style/DemoButton"
                android:text="@string/action_remove_email" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_aliases" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etAliasLabel"
                    style="@style/DemoInput.Half"
                    android:hint="@string/hint_alias_label"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/etAliasId"
                    style="@style/DemoInput.Half"
                    android:hint="@string/hint_alias_id"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddAlias"
                style="@style/DemoButton"
                android:text="@string/action_add_alias" />

            <Button
                android:id="@+id/btnRemoveAlias"
                style="@style/DemoButton"
                android:text="@string/action_remove_alias" />

            <EditText
                android:id="@+id/etAliases"
                style="@style/DemoInput"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_aliases"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnAddAliases"
                style="@style/DemoButton"
                android:text="@string/action_add_aliases" />

            <Button
                android:id="@+id/btnRemoveAliases"
                style="@style/DemoButton"
                android:text="@string/action_remove_aliases" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_subscription" />

            <Button
                android:id="@+id/btnOptIn"
                style="@style/DemoButton"
                android:text="@string/action_opt_in" />

            <Button
                android:id="@+id/btnOptOut"
                style="@style/DemoButton"
                android:text="@string/action_opt_out" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_notifications" />

            <Button
                android:id="@+id/btnSetBadge"
                style="@style/DemoButton"
                android:text="@string/action_set_badge" />

            <Button
                android:id="@+id/btnClearBadge"
                style="@style/DemoButton"
                android:text="@string/action_clear_badge" />

            <Button
                android:id="@+id/btnClearAll"
                style="@style/DemoButton"
                android:text="@string/action_clear_all" />

        </LinearLayout>
    </ScrollView>

    <TextView
        style="@style/SectionHeader"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/section_log" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#F2F2F2"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </ScrollView>

</LinearLayout>
