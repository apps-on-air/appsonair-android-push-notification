# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Gradle build outputs ──────────────────────────────────────────────────────
build/
.gradle/
**/build/
**/.gradle/

# ── Android local config ──────────────────────────────────────────────────────
# local.properties contains machine-specific SDK path — never commit
local.properties

# ── IntelliJ / Android Studio ─────────────────────────────────────────────────
.idea/
*.iml
*.hprof
captures/
.navigation/

# ── Sensitive / environment ───────────────────────────────────────────────────
# google-services.json belongs in the app module of the HOST app, not the SDK
google-services.json
*.jks
*.keystore
*.p12
*.p8

# ── Kotlin / Java ────────────────────────────────────────────────────────────
*.class
*.jar
*.aar
*.ap_

# The Gradle wrapper jar is the one jar that MUST be committed — JitPack (and any
# fresh clone) runs ./gradlew, which cannot bootstrap without it. Negates *.jar above.
# Leading **/ so this covers example/gradle/wrapper/ as well as the root wrapper.
!**/gradle/wrapper/gradle-wrapper.jar

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/
